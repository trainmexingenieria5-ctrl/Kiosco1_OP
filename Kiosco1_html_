<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Registro de Órdenes de Producción</title>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    body { font-family: Arial; padding: 20px; max-width: 600px; margin: auto; }
    input, select, button { width: 100%; padding: 10px; margin: 8px 0; }
    #reader { width: 100%; margin: 10px 0; }
    .hidden { display: none; }
  </style>
</head>
<body>
  <h2>Registrar Orden de Producción</h2>

  <div id="reader"></div>
  <button id="start-scan">Escanear Credencial QR</button>
  <button id="stop-scan" class="hidden">Detener Escaneo</button>

  <form id="registro-form" class="hidden">
    <input type="text" id="orden" placeholder="Orden de Producción (ej. OP-2026-001)" required />
    
    <input type="text" id="operario" placeholder="Operario (se llena al escanear)" readonly required />
    
    <input type="text" id="maquina" placeholder="Máquina (ej. CNC-05)" required />
    
    <input type="text" id="proceso" placeholder="Proceso (ej. Corte, Pintura, Ensamble)" required />
    
    <select id="estatus" required>
      <option value="">Seleccionar Estatus</option>
      <option value="En proceso">En proceso</option>
      <option value="Finalizado">Finalizado</option>
      <option value="Detenido">Detenido</option>
    </select>

    <button type="submit">Registrar en Google Sheets</button>
  </form>

  <div id="mensaje"></div>

  <script>
    const APP_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyp8831dNrQLrMiB8HVRlVluQfR6qmtW7tQQbROQcvqUCBfVTjJhuD9AW9jtS9nKdpDCA/exec"; // ← ¡Reemplaza!

    let html5QrCode = null;
    let operarioData = null;

    document.getElementById("start-scan").onclick = () => {
      const reader = document.getElementById("reader");
      reader.style.display = "block";
      document.getElementById("start-scan").classList.add("hidden");
      document.getElementById("stop-scan").classList.remove("hidden");

      html5QrCode = new Html5Qrcode("reader");
      html5QrCode.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: 250 },
        (decodedText) => {
          try {
            const data = JSON.parse(decodedText);
            if (data.nombre && data.id) {
              operarioData = data;
              document.getElementById("operario").value = data.nombre;
              html5QrCode.stop().then(() => html5QrCode.clear());
              document.getElementById("reader").style.display = "none";
              document.getElementById("registro-form").classList.remove("hidden");
            } else {
              alert("QR no válido. Debe contener 'nombre' e 'id'.");
            }
          } catch (e) {
            alert("Formato de QR inválido. Debe ser JSON válido.");
          }
        },
        (errorMessage) => {
          console.warn("Error de escaneo:", errorMessage);
        }
      );
    };

    document.getElementById("stop-scan").onclick = () => {
      if (html5QrCode) {
        html5QrCode.stop().then(() => html5QrCode.clear());
      }
      document.getElementById("reader").style.display = "none";
      document.getElementById("start-scan").classList.remove("hidden");
      document.getElementById("stop-scan").classList.add("hidden");
    };

    document.getElementById("registro-form").onsubmit = async (e) => {
      e.preventDefault();
      const mensaje = document.getElementById("mensaje");
      mensaje.textContent = "Enviando...";

      const data = {
        ordenProduccion: document.getElementById("orden").value,
        operario: operarioData.nombre,
        maquina: document.getElementById("maquina").value,
        proceso: document.getElementById("proceso").value,
        estatus: document.getElementById("estatus").value
      };

      try {
        const response = await fetch(APP_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors", // Google Apps Script solo acepta no-cors
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });

        // Con no-cors, no podemos leer la respuesta, pero si no hay error, asumimos éxito
        mensaje.textContent = "¡Registro guardado correctamente!";
        mensaje.style.color = "green";
        document.getElementById("registro-form").reset();
        document.getElementById("registro-form").classList.add("hidden");
        operarioData = null;
        setTimeout(() => mensaje.textContent = "", 3000);
      } catch (err) {
        mensaje.textContent = "Error al enviar. Verifica conexión.";
        mensaje.style.color = "red";
        console.error(err);
      }
    };
  </script>
</body>
</html>
